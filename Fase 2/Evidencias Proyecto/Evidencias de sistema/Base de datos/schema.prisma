// --- Configuración del generador ---
// Le dice a Prisma que genere el "cliente" (el código JS que usamos como
// prisma.usuario.create(), prisma.vacuna.findMany(), etc.) en node_modules
generator client {
  provider = "prisma-client-js"
}

// --- Configuración de la conexión a la base de datos ---
// provider indica qué motor de base de datos usamos (PostgreSQL)
// url la toma de la variable DATABASE_URL definida en el archivo .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Representa a cada persona que se registra en la app (dueño de mascota)
model Usuario {
  id        Int       @id @default(autoincrement()) // identificador único, autogenerado
  nombre    String
  email     String    @unique // @unique impide que dos usuarios tengan el mismo correo
  password  String    // guarda el HASH de la contraseña, nunca el texto original
  telefono  String?   // el "?" significa opcional
  comuna    String?
  createdAt DateTime  @default(now()) // fecha en que se creó la cuenta, se llena sola
  mascotas  Mascota[] // lado inverso: un usuario puede tener muchas mascotas
  pushToken String? // token del dispositivo para notificaciones push (vacío hasta que el frontend lo implemente)
  solicitudes SolicitudSangre[] // lado inverso: un usuario puede publicar varias solicitudes de sangre
  notificaciones Notificacion[] // lado inverso: un usuario puede recibir muchas notificaciones
  conversacionesComoA Conversacion[] @relation("ConversacionUsuarioA") // conversaciones donde es el participante A
  conversacionesComoB Conversacion[] @relation("ConversacionUsuarioB") // conversaciones donde es el participante B
  mensajesEnviados    Mensaje[]                                       // mensajes que ha escrito
}

// Representa a cada mascota registrada por un usuario
model Mascota {
  id              Int       @id @default(autoincrement())
  nombre          String
  especie         String
  raza            String?
  fechaNacimiento DateTime?
  sexo            String?
  foto            String?
  usuarioId       Int       // guarda el id del usuario dueño de esta mascota
  usuario         Usuario   @relation(fields: [usuarioId], references: [id]) // conecta con Usuario
  createdAt       DateTime  @default(now())
  vacunas         Vacuna[]          // lado inverso: una mascota puede tener muchas vacunas
  registrosMedicos RegistroMedico[] // lado inverso: una mascota puede tener muchos registros médicos
  donante Donante? // lado inverso: una mascota puede ser donante (el "?" = como máximo una vez)
}

// Representa cada vacuna aplicada (o por aplicar) a una mascota — S2-HU04
model Vacuna {
  id                    Int       @id @default(autoincrement())
  nombre                String
  fechaAplicacion       DateTime
  fechaProximoRefuerzo  DateTime? // opcional: no todas las vacunas requieren refuerzo
  aplicada              Boolean   @default(false) // empieza en falso; se usará en HU07 (recordatorios)
  mascotaId             Int
  mascota               Mascota   @relation(fields: [mascotaId], references: [id])
  createdAt             DateTime  @default(now())
  recordatorios Recordatorio[]
}

// Representa cada enfermedad/diagnóstico y su tratamiento — S2-HU05
model RegistroMedico {
  id           Int       @id @default(autoincrement())
  diagnostico  String    // obligatorio: sin esto no se puede guardar (escenario 2 de HU05)
  fecha        DateTime  // necesaria para poder ordenar el historial (escenario 3 de HU05)
  tratamiento  String?   // opcional: la historia no exige que sea obligatorio
  mascotaId    Int
  mascota      Mascota   @relation(fields: [mascotaId], references: [id])
  createdAt    DateTime  @default(now())
  documentos Documento[]
}

// Representa cada archivo (foto o PDF) adjuntado a un registro médico — S2-HU06
model Documento {
  id               Int             @id @default(autoincrement())
  nombreArchivo    String          // nombre original del archivo (ej: "radiografia.pdf")
  rutaArchivo      String          // dónde quedó guardado el archivo en el servidor
  tipoArchivo      String          // extensión o tipo (ej: "application/pdf", "image/png")
  tamano           Int             // tamaño del archivo en bytes
  registroMedicoId Int
  registroMedico   RegistroMedico  @relation(fields: [registroMedicoId], references: [id])
  createdAt        DateTime        @default(now())
}

// Registra cada intento de recordatorio de vacuna — S2-HU07
model Recordatorio {
  id         Int      @id @default(autoincrement())
  vacunaId   Int
  vacuna     Vacuna   @relation(fields: [vacunaId], references: [id])
  estado     String   // "enviado" (escenario 1) o "fallido" (escenario 2)
  fechaEnvio DateTime @default(now())
  visto      Boolean  @default(false) // si el usuario ya lo vio dentro de la app
}

// Mascota registrada como donante voluntario de sangre — S3-HU08
model Donante {
  id             Int      @id @default(autoincrement())
  mascotaId      Int      @unique // @unique: una mascota solo puede registrarse una vez como donante
  mascota        Mascota  @relation(fields: [mascotaId], references: [id])
  grupoSanguineo String?  // opcional: puede quedar pendiente si aún no se conoce
  estado         String   // "activo" (grupo conocido) o "pendiente" (grupo aún no conocido)
  createdAt      DateTime @default(now())
}

// Solicitud de sangre publicada por un usuario — S3-HU09
model SolicitudSangre {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      // quien publica la solicitud
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  especie        String   // especie de la mascota que necesita sangre
  grupoSanguineo String   // grupo sanguíneo requerido
  urgencia       String   // "alta", "media" o "baja" (obligatoria: escenario 2 de HU09)
  estado         String   @default("activa") // "activa" o "resuelta" (RF-13: se retira de las búsquedas)
  createdAt      DateTime @default(now())
  notificaciones Notificacion[] // lado inverso: una solicitud puede generar varias notificaciones
  
}

// Aviso que el sistema le crea a un usuario dentro de la plataforma — S4-HU11
// (en la versión web reemplaza a la notificación push del plan original)
model Notificacion {
  id          Int             @id @default(autoincrement())
  usuarioId   Int             // quién recibe el aviso (dueño del donante compatible)
  usuario     Usuario         @relation(fields: [usuarioId], references: [id])
  tipo        String          // por ahora solo "solicitud_compatible"
  mensaje     String          // texto que verá la persona
  solicitudId Int?            // solicitud que originó el aviso (opcional por si hay otros tipos más adelante)
  solicitud   SolicitudSangre? @relation(fields: [solicitudId], references: [id])
  leida       Boolean         @default(false) // empieza sin leer; el usuario la marcará como leída
  createdAt   DateTime        @default(now())
}
// Conversación directa entre dos usuarios — S4-HU12
// Para que una pareja tenga UNA sola conversación, guardamos siempre el id menor en A y el mayor en B
model Conversacion {
  id         Int       @id @default(autoincrement())
  usuarioAId Int       // id MENOR de los dos participantes
  usuarioA   Usuario   @relation("ConversacionUsuarioA", fields: [usuarioAId], references: [id])
  usuarioBId Int       // id MAYOR de los dos participantes
  usuarioB   Usuario   @relation("ConversacionUsuarioB", fields: [usuarioBId], references: [id])
  createdAt  DateTime  @default(now())
  mensajes   Mensaje[] // lado inverso: una conversación tiene muchos mensajes

  @@unique([usuarioAId, usuarioBId]) // impide crear dos conversaciones para la misma pareja
}

// Cada mensaje escrito dentro de una conversación — S4-HU12
model Mensaje {
  id             Int          @id @default(autoincrement())
  conversacionId Int
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id])
  remitenteId    Int          // quién lo escribió
  remitente      Usuario      @relation(fields: [remitenteId], references: [id])
  texto          String
  createdAt      DateTime     @default(now())
}